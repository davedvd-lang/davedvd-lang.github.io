<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de seguridad automática de Android (Android 6 a 11).

  Solo el espejo de la videoteca que escribe src/backup.js: un JSON pequeño que la
  app sabe leer y validar al restaurar. Antes, sin reglas, Android copiaba a ciegas
  los archivos internos del WebView (el LevelDB del localStorage), sin ninguna
  garantía de que se restaurasen bien en otro móvil.
-->
<full-backup-content>
    <include domain="file" path="butaca-backup.json" />
</full-backup-content>
